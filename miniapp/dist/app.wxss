page{background:#f3f6fb;color:#14213d;font-size:56rpx}.page-shell{box-sizing:border-box;min-height:100vh;padding:48rpx 48rpx 80rpx}.card{background:#fff;border:4rpx solid #e7edf5;border-radius:48rpx;box-shadow:0 16rpx 48rpx rgba(20,33,61,.05);padding:56rpx 48rpx}.page-tag{align-items:center;background:#e8eef8;border-radius:1998rpx;color:#4f658c;display:inline-flex;font-size:44rpx;line-height:1.2;padding:20rpx 36rpx;width:-moz-fit-content;width:fit-content}.page-title{color:#14213d;font-size:100rpx;font-weight:700;line-height:1.25}.page-subtitle{color:#5c6f91;font-size:56rpx;line-height:1.7}.button-primary{background:#14213d;border-radius:40rpx;color:#fff;font-size:56rpx;font-weight:600;padding:48rpx 0;text-align:center}.button-secondary{background:#fff;border:4rpx solid #dce5f2;border-radius:40rpx;color:#35496e;font-size:56rpx;padding:48rpx 0;text-align:center}.button-ghost{color:#6c7f9f;font-size:48rpx;padding:24rpx 0;text-align:center}.bottom-safe-area{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}