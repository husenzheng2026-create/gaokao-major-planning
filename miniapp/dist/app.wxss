page{background:#f3f6fb;color:#0f172a;font-size:56rpx;line-height:1.6}.page-shell{box-sizing:border-box;min-height:100vh;padding:48rpx 48rpx 80rpx}.bottom-safe-area{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.card{background:#fff;border:4rpx solid #e2e8f0;border-radius:48rpx;box-shadow:0 8rpx 32rpx rgba(15,23,42,.04);padding:56rpx 48rpx}.card-default{background:#fff;border-color:#e2e8f0}.card-focus{background:#fff;border-color:#1e293b}.card-warn{background:#fff5f5;border-color:#fecaca}.page-tag{align-items:center;background:#e8eef8;border-radius:1998rpx;color:#4f658c;display:inline-flex;font-size:44rpx;line-height:1.2;padding:20rpx 36rpx;width:-moz-fit-content;width:fit-content}.page-title{color:#0f172a;font-size:100rpx;font-weight:700;line-height:1.25}.page-subtitle{color:#64748b;font-size:56rpx;line-height:1.7}.section-title{color:#0f172a;font-size:60rpx;font-weight:600}.button-primary{background:#0f172a;border:none;border-radius:40rpx;color:#fff;font-size:56rpx;font-weight:600;padding:48rpx 0;text-align:center}.button-secondary{background:#fff;border:4rpx solid #e2e8f0;border-radius:40rpx;color:#334155;font-size:56rpx;padding:48rpx 0;text-align:center}.button-ghost{background:transparent;border:none;color:#64748b;font-size:52rpx;padding:32rpx 0;text-align:center}.button-ghost[disabled]{color:#cbd5e1}