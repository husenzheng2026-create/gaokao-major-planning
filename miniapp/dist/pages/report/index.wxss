.report-scroll{height:100vh}.report-page{display:flex;flex-direction:column;gap:36rpx}.report-action-body,.report-card,.report-footer,.report-hero,.report-row{display:flex;flex-direction:column;gap:28rpx}.report-archetype,.report-badge,.report-source{color:#64748b;font-size:48rpx;line-height:1.6}.report-headline{color:#14213d;font-size:88rpx;font-weight:700;line-height:1.28}.report-archetype{color:#314a76;font-size:68rpx;font-weight:600}.report-action-title,.report-card-title,.report-row-label,.report-section-title{color:#14213d;font-size:64rpx;font-weight:600;line-height:1.5}.report-bullet,.report-caution,.report-copy{color:#334155;font-size:52rpx;line-height:1.72}.report-copy--muted{color:#657897}.report-card--focus{background:linear-gradient(180deg,#fff,#f6f9ff)}.report-card--warn{background:#fff4f2;border-color:#ffd7cf}.report-card--center{align-items:center;margin-top:240rpx;text-align:center}.report-action{align-items:flex-start;display:flex;gap:32rpx}.report-action-index{background:#14213d;border-radius:1998rpx;color:#fff;font-size:48rpx;height:88rpx;line-height:88rpx;text-align:center;width:88rpx}.report-footer{margin-top:8rpx}