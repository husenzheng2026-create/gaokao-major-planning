.home-page{display:flex;flex-direction:column;gap:40rpx}.home-hero{display:flex;flex-direction:column;gap:32rpx;padding-top:16rpx}.home-card{display:flex;flex-direction:column;gap:36rpx}.home-card-title{color:#14213d;font-size:64rpx;font-weight:600}.home-card-copy,.home-disclaimer,.home-footer__hint,.home-point__text{color:#5c6f91;font-size:52rpx;line-height:1.7}.home-card--trust{gap:40rpx}.home-point{align-items:flex-start;display:flex;gap:32rpx}.home-point__index{background:#edf3fb;border-radius:28rpx;color:#35507d;flex-shrink:0;font-size:44rpx;font-weight:600;height:88rpx;line-height:88rpx;text-align:center;width:88rpx}.home-actions{display:flex;flex-direction:column;gap:28rpx;margin-top:16rpx}.home-footer{display:flex;flex-direction:column;gap:20rpx;padding:0 8rpx 32rpx}