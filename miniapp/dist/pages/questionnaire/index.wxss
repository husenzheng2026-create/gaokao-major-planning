.questionnaire-scroll{height:100vh}.questionnaire-progress-bar{background:#e2e8f0;height:12rpx;position:sticky;top:0;z-index:10}.questionnaire-progress-bar__fill{background:#0f172a;height:100%;transition:width .3s ease}.questionnaire-page{display:flex;flex-direction:column;gap:36rpx}.questionnaire-step{align-items:center;display:flex;justify-content:space-between}.questionnaire-step__count{color:#475569;font-size:48rpx;font-weight:600}.questionnaire-step__hint{color:#64748b;font-size:44rpx}.questionnaire-card{display:flex;flex-direction:column;gap:40rpx}.questionnaire-title{color:#0f172a;font-size:88rpx;font-weight:700;line-height:1.3}.questionnaire-description{color:#64748b;font-size:52rpx;line-height:1.65}.questionnaire-options{display:flex;flex-direction:column;gap:24rpx}.questionnaire-option{align-items:center;background:#fff;border:4rpx solid #e2e8f0;border-radius:36rpx;box-sizing:border-box;display:flex;justify-content:space-between;min-height:176rpx;padding:56rpx 48rpx}.questionnaire-option.is-selected{background:#f1f5f9;border-color:#1e293b}.questionnaire-option__label{color:#1e293b;flex:1;font-size:60rpx;line-height:1.5}.questionnaire-option__check{background:#0f172a;border-radius:50%;color:#fff;flex-shrink:0;font-size:44rpx;font-weight:700;height:88rpx;line-height:88rpx;text-align:center;width:88rpx}.questionnaire-option__circle{background:#fff;border:4rpx solid #cbd5e1;border-radius:50%;flex-shrink:0;height:88rpx;width:88rpx}.questionnaire-error{color:#be123c;font-size:48rpx;line-height:1.5}.questionnaire-actions{margin-top:8rpx}.questionnaire-actions__row{align-items:center;display:flex;gap:32rpx}.questionnaire-actions__continue{flex:1}