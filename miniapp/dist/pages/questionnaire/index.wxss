.questionnaire-scroll{height:100vh}.questionnaire-card,.questionnaire-page{display:flex;flex-direction:column;gap:48rpx}.questionnaire-actions,.questionnaire-progress{display:flex;gap:32rpx;justify-content:space-between}.questionnaire-description,.questionnaire-error,.questionnaire-option__label,.questionnaire-step{font-size:56rpx;line-height:1.7}.questionnaire-title{color:#0f172a;font-size:96rpx;font-weight:700;line-height:1.3}.questionnaire-description{color:#64748b}.progress-bar{background:#dbe4ee;border-radius:1998rpx;height:32rpx;overflow:hidden}.progress-bar__inner{background:#0f172a;height:100%}.questionnaire-options{display:flex;flex-direction:column;gap:32rpx}.questionnaire-option{background:#fff;border:4rpx solid #dbe4ee;border-radius:48rpx;display:flex;gap:32rpx;padding:48rpx}.questionnaire-option.is-selected{background:#eff6ff;border-color:#0f172a}.questionnaire-option__indicator{color:#0f172a;width:72rpx}.questionnaire-error{color:#be123c}.questionnaire-actions{margin-top:16rpx}