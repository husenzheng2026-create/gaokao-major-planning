.questionnaire-scroll{height:100vh}.questionnaire-card,.questionnaire-page{display:flex;flex-direction:column;gap:36rpx}.questionnaire-progress,.questionnaire-selection-tip{display:flex;gap:24rpx;justify-content:space-between}.questionnaire-actions__hint-text,.questionnaire-description,.questionnaire-error,.questionnaire-option__label,.questionnaire-progress__meta,.questionnaire-selection-tip__text{font-size:52rpx;line-height:1.65}.questionnaire-title{color:#14213d;font-size:88rpx;font-weight:700;line-height:1.3}.questionnaire-description{color:#64748b}.questionnaire-tag{margin-bottom:8rpx}.progress-bar{background:#d8e3f1;border-radius:1998rpx;height:24rpx;overflow:hidden}.progress-bar__inner{background:#14213d;height:100%}.questionnaire-options{display:flex;flex-direction:column;gap:28rpx}.questionnaire-option{background:#fff;border:4rpx solid #dde6f2;border-radius:40rpx;display:flex;padding:48rpx 44rpx}.questionnaire-option.is-selected{background:#edf4ff;border-color:#2f4d7d}.questionnaire-option__main{align-items:center;display:flex;gap:36rpx;justify-content:space-between;width:100%}.questionnaire-option__label{color:#20304f;flex:1}.questionnaire-option__pill{background:#f0f4fa;border-radius:1998rpx;color:#6d7f9d;flex-shrink:0;font-size:44rpx;line-height:1.2;padding:16rpx 28rpx}.questionnaire-option__pill.is-selected{background:#dce8fb;color:#24457b;font-weight:600}.questionnaire-error{color:#be123c}.questionnaire-actions{display:flex;flex-direction:column;gap:28rpx;margin-top:8rpx}.questionnaire-actions__hint{padding:24rpx 0 8rpx}.questionnaire-actions__hint-text{color:#7a8ca9;text-align:center}